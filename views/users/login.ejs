<% layout("/layouts/boilerplate") %>

<div class="noir-auth-wrapper">
  <div class="noir-auth-card">
    
    <div class="noir-auth-header">
      <div class="noir-brand-mark" style="margin: 0 auto; width: 3rem; height: 3rem; font-size: 1.25rem;">
        <i class="fa-solid fa-compass"></i>
      </div>
      <h1 class="noir-auth-title">Account Login</h1>
      <p class="noir-auth-sub">Enter your credentials to access your escapes and reviews.</p>
    </div>

    <form action="/login" method="POST" novalidate class="needs-validation">
      
      <!-- Username -->
      <div class="noir-form-group">
        <label for="username" class="noir-label">Username</label>
        <div class="noir-input-icon-group">
          <i class="fa-solid fa-user noir-input-icon"></i>
          <input 
            type="text" 
            name="username" 
            id="username" 
            placeholder="Username" 
            class="noir-input noir-input-with-icon" 
            required 
            autocomplete="username"
          />
        </div>
        <div class="invalid-feedback" style="color: var(--color-error); font-size: 0.8rem; margin-top: 0.35rem;">Please enter your username.</div>
      </div>

      <!-- Password -->
      <div class="noir-form-group">
        <label for="password" class="noir-label">Password</label>
        <div class="noir-input-icon-group">
          <i class="fa-solid fa-lock noir-input-icon"></i>
          <input 
            type="password" 
            name="password" 
            id="password" 
            placeholder="Password" 
            class="noir-input noir-input-with-icon" 
            required 
            autocomplete="current-password"
          />
        </div>
        <div class="invalid-feedback" style="color: var(--color-error); font-size: 0.8rem; margin-top: 0.35rem;">Please enter your password.</div>
      </div>

      <!-- Submit CTA -->
      <button type="submit" class="btn-noir-primary" style="width: 100%; padding: 0.85rem; font-size: 0.95rem; margin-top: 0.5rem;">
        <i class="fa-solid fa-right-to-bracket"></i>
        <span>Log in</span>
      </button>

    </form>

    <div style="text-align: center; margin-top: 1.75rem; font-size: 0.85rem; color: var(--text-secondary);">
      New to Wanderlust? <a href="/signup" style="color: var(--text-primary); font-weight: 700; text-decoration: underline;">Sign up</a>
    </div>

  </div>
</div>