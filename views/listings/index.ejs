<% layout("/layouts/boilerplate") %>

<!-- Category Navigation Bar -->
<section class="noir-category-section">
  <div class="noir-category-container">
    <div class="noir-category-track" id="categories-track">
      <a href="/listings" class="noir-category-btn" data-category="All">
        <i class="fa-solid fa-earth-americas"></i>
        <span>All Escapes</span>
      </a>
      <a href="/listings?category=Trending" class="noir-category-btn" data-category="Trending">
        <i class="fa-solid fa-fire"></i>
        <span>Trending</span>
      </a>
      <a href="/listings?category=Rooms" class="noir-category-btn" data-category="Rooms">
        <i class="fa-solid fa-bed"></i>
        <span>Rooms</span>
      </a>
      <a href="/listings?category=Iconic-Cities" class="noir-category-btn" data-category="Iconic Cities">
        <i class="fa-solid fa-mountain-city"></i>
        <span>Iconic Cities</span>
      </a>
      <a href="/listings?category=Mountains" class="noir-category-btn" data-category="Mountains">
        <i class="fa-solid fa-mountain"></i>
        <span>Mountains</span>
      </a>
      <a href="/listings?category=Castles" class="noir-category-btn" data-category="Castles">
        <i class="fa-brands fa-fort-awesome"></i>
        <span>Castles</span>
      </a>
      <a href="/listings?category=Pools" class="noir-category-btn" data-category="Pools">
        <i class="fa-solid fa-person-swimming"></i>
        <span>Pools</span>
      </a>
      <a href="/listings?category=Camping" class="noir-category-btn" data-category="Camping">
        <i class="fa-solid fa-tent"></i>
        <span>Camping</span>
      </a>
      <a href="/listings?category=Farms" class="noir-category-btn" data-category="Farms">
        <i class="fa-solid fa-tractor"></i>
        <span>Farms</span>
      </a>
      <a href="/listings?category=Arctic" class="noir-category-btn" data-category="Arctic">
        <i class="fa-solid fa-snowflake"></i>
        <span>Arctic</span>
      </a>
      <a href="/listings?category=Beach" class="noir-category-btn" data-category="Beach">
        <i class="fa-solid fa-umbrella-beach"></i>
        <span>Beachfront</span>
      </a>
      <a href="/listings?category=Vineyards" class="noir-category-btn" data-category="Vineyards">
        <i class="fa-solid fa-wine-bottle"></i>
        <span>Vineyards</span>
      </a>
      <a href="/listings?category=Kitchen" class="noir-category-btn" data-category="Kitchen">
        <i class="fa-solid fa-kitchen-set"></i>
        <span>Kitchen</span>
      </a>
      <a href="/listings?category=GameHub" class="noir-category-btn" data-category="GameHub">
        <i class="fa-solid fa-gamepad"></i>
        <span>GameHub</span>
      </a>
      <a href="/listings?category=Nature" class="noir-category-btn" data-category="Nature">
        <i class="fa-solid fa-leaf"></i>
        <span>Nature</span>
      </a>
      <a href="/listings?category=Business" class="noir-category-btn" data-category="Business">
        <i class="fa-solid fa-briefcase"></i>
        <span>Business</span>
      </a>
      <a href="/listings?category=Vacation" class="noir-category-btn" data-category="Vacation">
        <i class="fa-solid fa-umbrella"></i>
        <span>Vacation</span>
      </a>
      <a href="/listings?category=Music" class="noir-category-btn" data-category="Music">
        <i class="fa-solid fa-music"></i>
        <span>Music</span>
      </a>
    </div>
  </div>
</section>

<!-- Dynamic Listings Grid -->
<div class="noir-listings-grid">
  <% if (allListings && allListings.length > 0) { %>
    <% for (let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="noir-card">
        
        <div class="noir-card-media">
          <% if (listing.category) { %>
            <span class="noir-card-category-tag"><%= listing.category %></span>
          <% } %>
          
          <img 
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=75' %>" 
            alt="<%= listing.title %>" 
            class="noir-card-img"
            loading="lazy"
          />
        </div>

        <div class="noir-card-body">
          <div class="noir-card-header-row">
            <div class="noir-card-location"><%= listing.location %>, <%= listing.country %></div>
            <div class="noir-card-rating">
              <i class="fa-solid fa-star"></i>
              <span><%= (4.7 + (listing.title.length % 4) * 0.08).toFixed(2) %></span>
            </div>
          </div>

          <div class="noir-card-title"><%= listing.title %></div>

          <div class="noir-card-price-row">
            <span class="noir-card-price">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
            <span class="noir-card-unit">/ night</span>
          </div>
        </div>

      </a>
    <% } %>
  <% } else { %>
    <div style="grid-column: 1 / -1; text-align: center; padding: 5rem 2rem; background: var(--bg-surface); border-radius: var(--radius-md); border: 1px dashed var(--border-medium);">
      <i class="fa-solid fa-compass" style="font-size: 2.5rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
      <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">No escapes found</h3>
      <p style="font-size: 0.9rem; color: var(--text-secondary); max-width: 400px; margin: 0 auto 1.5rem auto;">There are currently no listings matching this filter. Explore all retreats in our collection.</p>
      <a href="/listings" class="btn-noir-primary">
        <span>View All Escapes</span>
      </a>
    </div>
  <% } %>
</div>
