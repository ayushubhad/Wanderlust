<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust — Curated Architectural & Nature Escapes</title>
    
    <!-- Meta tags -->
    <meta name="description" content="Discover curated architectural retreats, boutique sanctuaries, and nature escapes worldwide.">
    <meta name="theme-color" content="#080B11">

    <!-- Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Mapbox GL JS & CSS -->
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.26.0/mapbox-gl.css" rel="stylesheet">
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.26.0/mapbox-gl.js"></script>

    <!-- Rating & Dark Theme Stylesheet -->
    <link rel="stylesheet" href="/css/rating.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <!-- Top Navigation -->
    <%- include("../includes/navbar.ejs") %>

    <!-- Floating Flash Notification Alerts -->
    <%- include("../includes/flash.ejs") %>

    <!-- Main Dynamic Content -->
    <main class="main-content">
        <%- body %>
    </main>

    <!-- Dark Minimalist Footer -->
    <%- include("../includes/footer.ejs") %>

    <!-- Client Scripts -->
    <script src="/js/script.js"></script>
    <script src="/js/search.js"></script>
